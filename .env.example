# ── ЮKassa (оплата «Войти в бой») ─────────────────────────────────────────────
# Получить в https://yookassa.ru → Настройки → API-ключи
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Webhook в кабинете ЮKassa:
# https://warrior-point.vercel.app/api/payment/webhook

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — ТОЛЬКО сервер (API routes). Никогда не с префиксом NEXT_PUBLIC.
# Нужен для персистентности платежей (payment_intents) и серверных начислений.
# Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО задать в проде (подпись JWT-сессий). Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Токен бота из @BotFather — обязателен для входа через Telegram Mini App
# (HMAC-проверка initData). Без него telegram-логин отклоняется.
TELEGRAM_BOT_TOKEN=

# ── Production fail-closed ────────────────────────────────────────────────────
# На Vercel production:
#   LIVE_ECONOMY_LOCK=1
#   ALLOW_DEMO_ECONOMY не задавать
#   CHECKIN_SECRET и WARRIOR_ADMIN_SECRET — отдельные секреты
# Импорт бойцов /admin/fighters/import: роль admin или этот секрет.
# Миграция 0026_fighter_invite_drafts.sql — иначе черновики только в памяти.
LIVE_ECONOMY_LOCK=1
CHECKIN_SECRET=
WARRIOR_ADMIN_SECRET=

# Только local/staging. В production этот флаг игнорируется, если не задан явно
# вместе с пониманием риска (бесплатные XP/донаты).
# ALLOW_DEMO_ECONOMY=1

# ── OAuth (опционально; пустые провайдеры не регистрируются) ──────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_ID=
# APPLE_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=
# SBER_CLIENT_ID=
# SBER_CLIENT_SECRET=
